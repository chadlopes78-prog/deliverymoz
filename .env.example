# ───────────── Base de dados (obrigatório) ─────────────
# PostgreSQL gerido (ex.: Neon, Supabase, Vercel Postgres). Use a URL com pooling em DATABASE_URL
# e a ligação direta em DIRECT_URL (usada pelas migrações).
DATABASE_URL="postgresql://utilizador:password@host:5432/deliverymoz?sslmode=require"
DIRECT_URL="postgresql://utilizador:password@host:5432/deliverymoz?sslmode=require"

# URL pública da aplicação (links de e-mail, sitemap, Open Graph)
APP_URL="https://o-seu-dominio.co.mz"

# ───────────── Configuração inicial (obrigatório no primeiro arranque) ─────────────
# Código secreto (mínimo 16 caracteres) exigido em /configuracao para criar a conta do proprietário.
# Gere com: openssl rand -base64 24   — pode ser removido depois de criar a conta.
SETUP_TOKEN=""

# Segredo usado pela Vercel Cron para chamar /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# ───────────── E-mail transacional (opcional — Resend) ─────────────
RESEND_API_KEY=""
EMAIL_FROM="DeliveryMoz <nao-responder@o-seu-dominio.co.mz>"

# ───────────── Armazenamento de imagens públicas (opcional — Vercel Blob) ─────────────
# Sem este token as imagens são guardadas na base de dados e servidas por /api/files/[id].
BLOB_READ_WRITE_TOKEN=""

# ───────────── M-Pesa Vodacom Moçambique (opcional) ─────────────
# Credenciais obtidas no portal https://developer.mpesa.vm.co.mz/
MPESA_ENV="sandbox"                 # sandbox | live
MPESA_API_KEY=""
MPESA_PUBLIC_KEY=""                 # chave pública (base64, sem cabeçalhos) fornecida no portal
MPESA_SERVICE_PROVIDER_CODE=""      # código do comerciante (shortcode), ex.: 171717 em sandbox
MPESA_ORIGIN=""                     # valor do cabeçalho Origin registado no portal
# MPESA_API_HOST=""                 # opcional: sobrepõe o anfitrião por omissão
# Apenas para reembolsos automáticos (reversão):
MPESA_INITIATOR_IDENTIFIER=""
MPESA_SECURITY_CREDENTIAL=""
